---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Programa de Neurociencia y Meditación con Jessica Vega Puch. De la ansiedad a la calma."
    />
    <title>De la Ansiedad a la Calma | Jessica Vega Puch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="cinta-spacer" aria-hidden="true"></div>
    <div class="cinta" role="presentation" aria-hidden="true">
      <div class="cinta__track">
        {
          [0, 1].map(() => (
            <div class="cinta__group">
              {cintaItems.map((item) => (
                <>
                  <span class="cinta__item">{item}</span>
                  <span class="cinta__sep">•</span>
                </>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <main>
      <!-- 1. HERO / VSL PRINCIPAL -->
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="container hero__inner">
          <p class="badge reveal">PROGRAMA DE ANSIEDAD A LA CALMA</p>

          <h1 id="hero-title" class="reveal reveal--delay-1">
            Aprende a vivir una vida sin ansiedad y estar conectada contigo
            mismo y con la realidad.
          </h1>

          <div class="hero__video-wrap reveal reveal--delay-2">
            <video
              class="hero__video"
              src={heroVideoSrc}
              poster={heroPoster}
              autoplay
              muted
              loop
              playsinline
              webkit-playsinline
              preload="auto"
              disablepictureinpicture
              disableremoteplayback
              aria-label="Video principal del programa"
            ></video>
            <button
              type="button"
              class="hero__unmute"
              aria-label="Activar sonido del video"
            >
              Toca para oír
            </button>
          </div>

          <a
            class="btn btn--primary btn--wide reveal reveal--delay-3"
            href={checkoutUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Sí, quiero vivir sin ansiedad
          </a>
          <p class="hero__secondary reveal reveal--delay-3">
            ¿Tienes dudas?
            <a
              class="link-whatsapp"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Agenda una llamada de 15 minutos conmigo
            </a>
          </p>

          <div
            class="info-strip reveal reveal--delay-3"
            aria-label="Datos del programa"
          >
            {
              programaInfo.map((item) => (
                <div class="info-strip__card">
                  <span class="info-strip__icon" aria-hidden="true">
                    {item.icon === "hourglass" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M6 2h12" />
                        <path d="M6 22h12" />
                        <path d="M8 2v3.5c0 1.4.7 2.7 1.9 3.5L12 11l2.1-2c1.2-.8 1.9-2.1 1.9-3.5V2" />
                        <path d="M8 22v-3.5c0-1.4.7-2.7 1.9-3.5L12 13l2.1 2c1.2.8 1.9 2.1 1.9 3.5V22" />
                      </svg>
                    )}
                    {item.icon === "calendar" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="3" y="5" width="18" height="16" rx="2" />
                        <path d="M3 10h18" />
                        <path d="M8 3v4" />
                        <path d="M16 3v4" />
                      </svg>
                    )}
                    {item.icon === "classroom" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M4 19V7l8-3 8 3v12" />
                        <path d="M4 19l8-3 8 3" />
                        <path d="M12 4v12" />
                        <path d="M8 10.5v2" />
                        <path d="M16 10.5v2" />
                      </svg>
                    )}
                    {item.icon === "clock" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                      </svg>
                    )}
                  </span>
                  <div class="info-strip__text">
                    <span class="info-strip__label">{item.label}</span>
                    <span class="info-strip__value">{item.value}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <div class="divider" aria-hidden="true"></div>

      <!-- 2. MENTORA -->
      <section class="section mentora" aria-labelledby="mentora-name">
        <div class="container">
          <div class="mentora__grid">
            <div class="mentora__photo">
              <img
                src="/imagenes/jessica-vega-puch.jpeg"
                alt="Jessica Vega Puch, mentora de neurociencia y meditación"
                width="640"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="mentora__content">
              <p class="mentora__label">Quién te va a formar</p>
              <h2 id="mentora-name" class="mentora__name">Jessica Vega Puch</h2>

              <div class="mentora__credenciales">
                {
                  mentoraMetricas.map((item) => (
                    <div class="mentora__credencial">
                      <div class="mentora__stat">{item.cifra}</div>
                      <p class="mentora__credencial-texto">{item.texto}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. TESTIMONIOS (6 VIDEOS) -->
      <section class="section testimonios" aria-labelledby="testimonios-title">
        <div class="container">
          <h2 id="testimonios-title" class="section__title">
            Historias de transformación y resultados
          </h2>

          <div class="testimonios__grid">
            {
              testimonios.map((item, i) => (
                <div class="testimonio-media">
                  <video
                    class="lazy-video"
                    data-src={
                      item.startAt
                        ? `${item.src}#t=${item.startAt}`
                        : item.src
                    }
                    poster={item.poster}
                    controls
                    muted
                    loop
                    playsinline
                    webkit-playsinline
                    preload="none"
                    aria-label={`Video testimonio ${i + 1}`}
                  ></video>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 4. ¿PARA QUIÉN ES ESTE CURSO? -->
      <section class="section para-quien" aria-labelledby="para-quien-title">
        <div class="container">
          <h2 id="para-quien-title" class="section__title">
            ¿Para quién es este curso?
          </h2>

          <ul class="para-quien__lista">
            {
              paraQuien.map((item) => (
                <li class="para-quien__item">
                  <span class="para-quien__check" aria-hidden="true">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="none"
                    >
                      <path
                        d="M4.5 10.5l3.5 3.5 7.5-8"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>

          <div class="para-quien__galeria" aria-label="Galería del programa">
            {
              paraQuienGaleria.map((img) => (
                <figure class="para-quien__shot">
                  <img
                    src={img.src}
                    alt={img.alt}
                    width="640"
                    height="480"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 5. ¿QUÉ INCLUYE? -->
      <section class="section incluye" aria-labelledby="incluye-title">
        <div class="container">
          <h2 id="incluye-title" class="section__title">
            Programa: De la Ansiedad a la Calma en 30 días
          </h2>

          <h3 class="incluye__subtitulo">El programa Incluye</h3>
          <ul class="incluye__list">
            {
              pilares.map((item) => (
                <li class={item.highlight ? "incluye__item--bono" : undefined}>
                  <strong>{item.title}</strong>
                  <span>{item.text}</span>
                </li>
              ))
            }
          </ul>

          <details class="incluye__acordeon">
            <summary>¿Quieres ver el programa completo, clase por clase?</summary>
            <ol class="incluye__clases">
              {
                clasesPrograma.map((clase) => (
                  <li>
                    <strong>{clase.title}</strong>
                    <span>{clase.text}</span>
                  </li>
                ))
              }
            </ol>
          </details>
        </div>
      </section>

      <div class="divider" aria-hidden="true"></div>

      <!-- 6. DECISIÓN: urgencia → oferta → CTA -->
      <section
        class="section decision"
        id="reservar"
        aria-labelledby="por-que-ahora-title"
      >
        <div class="container decision__inner">
          <div class="urgencia">
            <h2 id="por-que-ahora-title" class="urgencia__title">Por qué ahora</h2>
            <p>
              Esta es la última cohorte del año. Un programa en comunidad
              funciona mejor cuando todas entran juntas, empiezan el mismo día y
              avanzan al mismo ritmo.
            </p>
            <p class="urgencia__cierre">
              El
              <span class="urgencia__fecha">17 de octubre</span> el acceso se
              cierra para no interrumpir el proceso de la primera parte.
            </p>
            <p>
              Si sabes que este es tu momento, no lo dejes para después. Si no
              entras ahora, tendrás que esperar un año entero con la misma
              ansiedad.
            </p>
          </div>

          <div class="oferta-wrap">
            <p class="oferta__badge">Oferta por tiempo limitado</p>
            <article class="oferta" aria-labelledby="oferta-title">
              <header class="oferta__header">
                <h3 id="oferta-title" class="oferta__titulo">
                  Precio especial hasta el 25 de setiembre
                </h3>
              <p class="oferta__precio">
                <span class="oferta__precio-antes" aria-label="Precio regular">
                  <span class="oferta__moneda">S/</span>1,120
                </span>
                <span class="oferta__precio-sep" aria-hidden="true">—</span>
                <span class="oferta__precio-ahora">
                  <span class="oferta__moneda">S/</span>952
                </span>
              </p>
              <p class="oferta__inversion">
                Inversión: S/952 (regular S/1,120) — Pago único o en 3 cuotas
              </p>
            </header>

            <ul class="oferta__lista">
              {
                ofertaBeneficios.map((beneficio) => (
                  <li
                    class:list={[
                      "oferta__item",
                      typeof beneficio === "object" && "oferta__item--bono",
                    ]}
                  >
                    <span class="oferta__check" aria-hidden="true">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="none"
                      >
                        <path
                          d="M4.5 10.5l3.5 3.5 7.5-8"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    <p>
                      {typeof beneficio === "object" ? (
                        <>
                          <strong>{beneficio.title}:</strong> {beneficio.text}
                        </>
                      ) : (
                        beneficio
                      )}
                    </p>
                  </li>
                ))
              }
            </ul>

            <div class="oferta__garantia">
              <p class="oferta__garantia-titulo">Nuestra Garantía</p>
              <p class="oferta__garantia-texto">
                “Si después de las primeras 2 clases sientes que no es para ti,
                te devolvemos el 100%, sin preguntas.”
              </p>
            </div>

            <a
              class="btn btn--primary btn--wide oferta__cta"
              href={checkoutUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Reserva tu cupo ahora
            </a>

            <p class="oferta__confianza">
              <span>Pago único o en 3 cuotas</span>
              <span class="oferta__dot" aria-hidden="true">•</span>
              <span>Garantía de satisfacción</span>
            </p>

            <p class="oferta__pie">
              ¿No tienes el monto completo hoy? Puedes dividirlo en 3 cuotas.
            </p>
          </article>
          </div>

          <p class="decision__secondary">
            ¿Aún tienes dudas?
            <a
              class="link-whatsapp"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Agenda una llamada de 15 minutos con el equipo
            </a>
          </p>
        </div>
      </section>

      <!-- 7. FAQ -->
      <section class="section faq" aria-labelledby="faq-title">
        <div class="container container--narrow">
          <h2 id="faq-title" class="section__title">Preguntas frecuentes</h2>

          <div class="faq__list">
            {
              faqs.map((item) => (
                <details class="faq__item">
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <!-- BOTÓN FLOTANTE WHATSAPP -->
    <a
      class="whatsapp-float"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escribir por WhatsApp"
