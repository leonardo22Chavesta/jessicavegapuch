    <script is:inline>
      (() => {
        if ("scrollRestoration" in history) {
          history.scrollRestoration = "manual";
        }

        const VIDEO_CACHE = "neuro-videos-v3";
        const cleanVideoUrl = (url) => String(url || "").split("#")[0];
        const isMobileViewport = () =>
          window.matchMedia("(max-width: 640px)").matches;
        const getConnection = () =>
          navigator.connection ||
          navigator.mozConnection ||
          navigator.webkitConnection ||
          null;
        const isSlowConnection = () => {
          const conn = getConnection();
          if (!conn) return false;
          if (conn.saveData) return true;
          return ["slow-2g", "2g"].includes(conn.effectiveType || "");
        };

        const pickResponsiveUrl = (el, desktopAttr, mobileAttr) => {
          const mobile = el.getAttribute(mobileAttr);
          const desktop = el.getAttribute(desktopAttr);
          if (isMobileViewport() && mobile) return mobile;
          return desktop || mobile || "";
        };

        const openVideoCache = async () => {
          if (!("caches" in window)) return null;
          try {
            return await caches.open(VIDEO_CACHE);
          } catch (_) {
            return null;
          }
        };

        const getCachedBlobUrl = async (remoteUrl) => {
          const url = cleanVideoUrl(remoteUrl);
          const cache = await openVideoCache();
          if (!cache) return null;
          try {
            const hit = await cache.match(url);
            if (!hit || !hit.ok) return null;
            const blob = await hit.blob();
            if (!blob || !blob.size) return null;
            return URL.createObjectURL(blob);
          } catch (_) {
            return null;
          }
        };

        const cacheVideoUrl = async (remoteUrl) => {
          const url = cleanVideoUrl(remoteUrl);
          const cache = await openVideoCache();
          if (!cache) return;
          try {
            const hit = await cache.match(url);
            if (hit) return;
            const res = await fetch(url, {
              mode: "cors",
              credentials: "omit",
            });
            if (res.ok) await cache.put(url, res.clone());
          } catch (_) {
            /* CORS o red: no bloquea la reproducción */
          }
        };

        const resetScrollTop = () => {
          window.scrollTo(0, 0);
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
        };

        resetScrollTop();
        window.addEventListener("load", resetScrollTop, { once: true });
        window.addEventListener(
          "pageshow",
          (event) => {
            if (event.persisted) resetScrollTop();
          },
          { once: true }
        );

        const trackHeroVideoForGtm = (video) => {
          const dataLayer = (window.dataLayer = window.dataLayer || []);
          const fired = {
            start: false,
            unmute: false,
            25: false,
            50: false,
            75: false,
            100: false,
          };
          const isHeroInView = () => {
            const rect = video.getBoundingClientRect();
            if (!rect.height) return false;
            const visible =
              Math.min(rect.bottom, window.innerHeight) -
              Math.max(rect.top, 0);
            return visible / rect.height >= 0.45;
          };
          let inView = isHeroInView();

          const pushVideoEvent = (eventName, extra) => {
            dataLayer.push(
              Object.assign(
                {
                  event: eventName,
                  video_title: "VSL Hero",
                  video_provider: "html5",
                  video_muted: !!video.muted,
                  video_visible: inView && !document.hidden,
                },
                extra || {}
              )
            );
          };

          const trackUnmute = () => {
            if (fired.unmute) return;
            fired.unmute = true;
            const duration = video.duration;
            const percent =
              duration && Number.isFinite(duration) && duration > 0
                ? Math.round((video.currentTime / duration) * 100)
                : 0;
            pushVideoEvent("video_unmute", {
              video_percent: percent,
              video_current_time: Math.round(video.currentTime || 0),
              video_duration: Math.round(duration || 0),
            });
          };

          if ("IntersectionObserver" in window) {
            const visibility = new IntersectionObserver(
              (entries) => {
                const entry = entries[0];
                inView = !!(
                  entry &&
                  entry.isIntersecting &&
                  entry.intersectionRatio >= 0.45
                );
              },
              { threshold: [0, 0.45, 1] }
            );
            visibility.observe(video);
          }

          video.addEventListener("playing", () => {
            if (fired.start) return;
            fired.start = true;
            pushVideoEvent("video_start", {
              video_percent: 0,
              video_current_time: 0,
              video_duration: Math.round(video.duration || 0),
            });
          });

          video.addEventListener("timeupdate", () => {
            if (document.hidden || !inView || video.paused) return;
            const duration = video.duration;
            if (!duration || !Number.isFinite(duration) || duration <= 0) {
              return;
            }
            const percent = (video.currentTime / duration) * 100;
            [
              { at: 25, event: "video_progress", key: 25 },
              { at: 50, event: "video_progress", key: 50 },
              { at: 75, event: "video_progress", key: 75 },
              { at: 95, event: "video_complete", key: 100 },
            ].forEach((mark) => {
              if (percent < mark.at || fired[mark.key]) return;
              fired[mark.key] = true;
              pushVideoEvent(mark.event, {
                video_percent: mark.key,
                video_current_time: Math.round(video.currentTime),
                video_duration: Math.round(duration),
              });
            });
          });

          return { trackUnmute };
        };

        const initHeroVideo = async () => {
          const heroVideo = document.querySelector("video.hero__video");
          const unmuteBtn = document.querySelector(".hero__unmute");
          const progressBar = document.querySelector(".hero__progress-bar");
          if (!heroVideo) return;

          const heroGtm = trackHeroVideoForGtm(heroVideo);

          let progressRaf = 0;
          const updateHeroProgress = () => {
            if (!progressBar) return;
            const duration = heroVideo.duration;
            if (!duration || !Number.isFinite(duration) || duration <= 0) {
              return;
            }
            const ratio = Math.min(
              1,
              Math.max(0, heroVideo.currentTime / duration)
            );
            progressBar.style.width = (ratio * 100).toFixed(2) + "%";
          };

          const stopProgressLoop = () => {
            if (progressRaf) {
              cancelAnimationFrame(progressRaf);
              progressRaf = 0;
            }
          };

          const startProgressLoop = () => {
            stopProgressLoop();
            const tick = () => {
              updateHeroProgress();
              if (!heroVideo.paused && !heroVideo.ended) {
                progressRaf = requestAnimationFrame(tick);
              }
            };
            progressRaf = requestAnimationFrame(tick);
          };

          heroVideo.addEventListener("timeupdate", updateHeroProgress);
          heroVideo.addEventListener("seeked", updateHeroProgress);
          heroVideo.addEventListener("loadedmetadata", updateHeroProgress);
          heroVideo.addEventListener("durationchange", updateHeroProgress);
          heroVideo.addEventListener("play", startProgressLoop);
          heroVideo.addEventListener("playing", startProgressLoop);
          heroVideo.addEventListener("pause", stopProgressLoop);
          heroVideo.addEventListener("ended", updateHeroProgress);

          const poster = pickResponsiveUrl(
            heroVideo,
            "data-poster",
            "data-poster-mobile"
          );
          if (poster) heroVideo.setAttribute("poster", poster);

          const remoteSrc = pickResponsiveUrl(
            heroVideo,
            "data-src",
            "data-src-mobile"
          );
          if (!remoteSrc) return;

          let soundUnlocked = false;
          let starting = false;
          let needsGesture = false;
          let srcReady = false;

          heroVideo.playsInline = true;
          heroVideo.setAttribute("playsinline", "");
          heroVideo.setAttribute("webkit-playsinline", "");
          heroVideo.defaultMuted = false;
          heroVideo.muted = false;
          heroVideo.removeAttribute("muted");
          heroVideo.volume = 1;
          heroVideo.preload = "auto";

          const hideUnmute = () => {
            if (unmuteBtn) unmuteBtn.hidden = true;
          };

          const showUnmute = () => {
            if (unmuteBtn) unmuteBtn.hidden = false;
          };

          const removeUnlockListeners = () => {
            ["pointerdown", "touchstart", "keydown"].forEach((eventName) => {
              window.removeEventListener(eventName, unlockSound, true);
            });
          };

          const unlockSound = () => {
            if (soundUnlocked) return;
            soundUnlocked = true;
            needsGesture = false;
            heroVideo.muted = false;
            heroVideo.removeAttribute("muted");
            heroVideo.defaultMuted = false;
            heroVideo.volume = 1;
            const playPromise = heroVideo.play();
            if (playPromise && typeof playPromise.catch === "function") {
              playPromise.catch(() => {});
            }
            hideUnmute();
            removeUnlockListeners();
            heroGtm.trackUnmute();
          };

          const enableGestureUnlock = () => {
            if (needsGesture) return;
            needsGesture = true;
            showUnmute();
            ["pointerdown", "touchstart", "keydown"].forEach((eventName) => {
              window.addEventListener(eventName, unlockSound, {
                capture: true,
                passive: true,
              });
            });
            if (unmuteBtn) {
              unmuteBtn.addEventListener("click", (event) => {
                event.stopPropagation();
                unlockSound();
              });
            }
          };

          const playWithSound = () => {
            if (!srcReady || soundUnlocked || starting) return;
            starting = true;
            heroVideo.muted = false;
            heroVideo.removeAttribute("muted");
            heroVideo.defaultMuted = false;
            heroVideo.volume = 1;

            const playPromise = heroVideo.play();
            if (playPromise && typeof playPromise.then === "function") {
              playPromise
                .then(() => {
                  soundUnlocked = true;
                  hideUnmute();
                  removeUnlockListeners();
                })
                .catch(() => {
                  heroVideo.muted = true;
                  heroVideo.setAttribute("muted", "");
                  heroVideo.play().catch(() => {});
                  enableGestureUnlock();
                })
                .finally(() => {
                  starting = false;
                });
            } else {
              starting = false;
              soundUnlocked = !heroVideo.muted;
            }
          };

          // URL remota primero (play inmediato); caché blob solo si ya existe.
          const cached = await getCachedBlobUrl(remoteSrc);
          heroVideo.src = cached || remoteSrc;
          heroVideo.load();
          srcReady = true;
          playWithSound();
          if (!cached) cacheVideoUrl(remoteSrc);

          ["loadedmetadata", "loadeddata", "canplay", "canplaythrough"].forEach(
            (eventName) => {
              heroVideo.addEventListener(eventName, playWithSound);
            }
          );

          heroVideo.addEventListener("pause", () => {
            if (document.hidden) return;
            if (soundUnlocked) {
              heroVideo.muted = false;
              heroVideo.play().catch(() => {});
            } else {
              playWithSound();
            }
          });

          document.addEventListener("visibilitychange", () => {
            if (document.hidden) return;
            if (soundUnlocked) {
              heroVideo.muted = false;
              heroVideo.play().catch(() => {});
            } else {
              playWithSound();
            }
          });

          window.addEventListener("pageshow", () => {
            if (soundUnlocked) {
              heroVideo.muted = false;
              heroVideo.play().catch(() => {});
            } else {
              playWithSound();
            }
          });

          return heroVideo;
        };

        const initLazyVideos = (heroVideo) => {
          const videos = Array.from(
            document.querySelectorAll("video.lazy-video")
          );
          if (!videos.length) return;

          const assignPoster = (video) => {
            const poster = pickResponsiveUrl(
              video,
              "data-poster",
              "data-poster-mobile"
            );
            if (poster) video.setAttribute("poster", poster);
          };

          // Posters ya en HTML; afinar desktop vs móvil al instante.
          videos.forEach(assignPoster);

          const applyStartAt = (video) => {
            const startAt = Number(video.getAttribute("data-start-at") || 0);
            if (!startAt || Number.isNaN(startAt)) return;
            const seek = () => {
              try {
                if (Math.abs(video.currentTime - startAt) > 0.35) {
                  video.currentTime = startAt;
                }
              } catch (_) {}
            };
            if (video.readyState >= 1) seek();
            else video.addEventListener("loadedmetadata", seek, { once: true });
          };

          const attachSource = async (video, { play = false } = {}) => {
            const remoteSrc = pickResponsiveUrl(
              video,
              "data-src",
              "data-src-mobile"
            );
            if (!remoteSrc) return;

            assignPoster(video);

            if (!video.getAttribute("src")) {
              // No esperamos el blob: prioridad a reproducción / buffer rápido.
              video.preload = "auto";
              video.src = remoteSrc;
              video.setAttribute("src", remoteSrc);
              video.load();
              applyStartAt(video);
              getCachedBlobUrl(remoteSrc).then((cached) => {
                if (!cached || video.dataset.swapped === "1") return;
                // Solo swap si aún no empezó a reproducir con buffer.
                if (video.readyState < 2 && video.paused) {
                  video.dataset.swapped = "1";
                  video.src = cached;
                  video.load();
                  applyStartAt(video);
                }
              });
              cacheVideoUrl(remoteSrc);
            }

            if (play) {
              const playPromise = video.play();
              if (playPromise && typeof playPromise.catch === "function") {
                playPromise.catch(() => {});
              }
            }
          };

          const waitForBuffer = (video, ms = 8000) =>
            new Promise((resolve) => {
              if (video.readyState >= 3) {
                resolve();
                return;
              }
              const done = () => {
                cleanup();
                resolve();
              };
              const cleanup = () => {
                video.removeEventListener("canplay", done);
                video.removeEventListener("canplaythrough", done);
                clearTimeout(timer);
              };
              video.addEventListener("canplay", done, { once: true });
              video.addEventListener("canplaythrough", done, { once: true });
              const timer = setTimeout(done, ms);
            });

          // Precarga secuencial: cuando el usuario toque play, ya hay buffer.
          const warmVideos = async () => {
            const limit = isSlowConnection() ? 2 : videos.length;
            for (let i = 0; i < limit; i++) {
              const video = videos[i];
              if (video.dataset.warmed === "1") continue;
              video.dataset.warmed = "1";
              await attachSource(video, { play: false });
              await waitForBuffer(video, isMobileViewport() ? 7000 : 5000);
            }
          };

          const startWarmWhenReady = () => {
            const kickoff = () => {
              const run = () => {
                warmVideos();
              };
              if ("requestIdleCallback" in window) {
                requestIdleCallback(run, { timeout: 1800 });
              } else {
                setTimeout(run, 600);
              }
            };

            if (!heroVideo) {
              kickoff();
              return;
            }

            if (heroVideo.readyState >= 3) {
              // Hero ya con buffer: liberamos un poco de red y arrancamos.
              setTimeout(kickoff, 350);
            } else {
              heroVideo.addEventListener("canplay", () => setTimeout(kickoff, 350), {
                once: true,
              });
              // Fallback si el hero tarda o falla.
              setTimeout(kickoff, 2200);
            }
          };

          startWarmWhenReady();

          if (!("IntersectionObserver" in window)) {
            videos.forEach((video) => attachSource(video, { play: true }));
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                const video = entry.target;
                if (entry.isIntersecting) {
                  video.dataset.warmed = "1";
                  attachSource(video, { play: true });
                } else {
                  video.pause();
                }
              });
            },
            {
              root: null,
              rootMargin: isMobileViewport() ? "400px 0px" : "480px 0px",
              threshold: 0.05,
            }
          );

          videos.forEach((video) => observer.observe(video));
        };

        const boot = async () => {
          const heroVideo = await initHeroVideo();
          initLazyVideos(heroVideo || null);
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", boot);
        } else {
          boot();
        }
      })();
    </script>
  </body>
</html>

