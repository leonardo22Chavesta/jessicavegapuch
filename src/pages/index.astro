    text: "Construir el hábito y hacer las paces con tu crítico interno.",
  },
  {
    title: "Acompañamiento y Comunidad",
    text: "Soporte por WhatsApp de lunes a viernes.",
  },
];

const clasesPrograma = [
  {
    title: "Clase 1: Introducción al mindfulness",
    text: "Qué es, por qué funciona, ejercicios y técnicas de respiración.",
  },
  {
    title: "Clase 2: Estrés, ansiedad y botiquín de emergencia emocional",
    text: "Técnicas rápidas para un ataque de pánico, alimentación y suplementos.",
  },
  {
