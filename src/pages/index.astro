    <script is:inline>
      (() => {
        if ("scrollRestoration" in history) {
          history.scrollRestoration = "manual";
        }

        const resetScrollTop = () => {
          window.scrollTo(0, 0);
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
        };

        resetScrollTop();
        window.addEventListener("load", resetScrollTop, { once: true });
        window.addEventListener(
          "pageshow",
          (event) => {
            if (event.persisted) resetScrollTop();
          },
          { once: true }
        );

        const initHeroVideo = () => {
          const heroVideo = document.querySelector("video.hero__video");
          const unmuteBtn = document.querySelector(".hero__unmute");
          if (!heroVideo) return;

          let soundUnlocked = false;
          let starting = false;

          heroVideo.playsInline = true;
          heroVideo.setAttribute("playsinline", "");
          heroVideo.setAttribute("webkit-playsinline", "");
          heroVideo.defaultMuted = true;
          heroVideo.muted = true;
          heroVideo.setAttribute("muted", "");

          const playMutedNow = () => {
            if (soundUnlocked || starting) return;
            starting = true;
            heroVideo.muted = true;
            heroVideo.setAttribute("muted", "");
            const playPromise = heroVideo.play();
            if (playPromise && typeof playPromise.finally === "function") {
              playPromise.catch(() => {}).finally(() => {
                starting = false;
              });
            } else {
              starting = false;
            }
          };

          const hideUnmute = () => {
            if (unmuteBtn) unmuteBtn.hidden = true;
          };

          const showUnmute = () => {
            if (unmuteBtn) unmuteBtn.hidden = false;
          };

          const unlockSound = () => {
            if (soundUnlocked) return;
            soundUnlocked = true;
            heroVideo.muted = false;
            heroVideo.removeAttribute("muted");
            heroVideo.defaultMuted = false;
            heroVideo.volume = 1;
            const playPromise = heroVideo.play();
            if (playPromise && typeof playPromise.catch === "function") {
              playPromise.catch(() => {});
            }
            hideUnmute();
            removeUnlockListeners();
          };

          const unlockEvents = ["pointerdown", "touchstart", "keydown"];
          const removeUnlockListeners = () => {
            unlockEvents.forEach((eventName) => {
              window.removeEventListener(eventName, unlockSound, true);
            });
          };

          const enableGestureUnlock = () => {
            showUnmute();
            unlockEvents.forEach((eventName) => {
              window.addEventListener(eventName, unlockSound, {
                capture: true,
                passive: true,
              });
            });
            if (unmuteBtn) {
              unmuteBtn.addEventListener("click", (event) => {
                event.stopPropagation();
                unlockSound();
              });
            }
          };

          // En móvil: arranca YA en silencio (único modo fiable de autoplay).
          playMutedNow();
          enableGestureUnlock();

          ["loadedmetadata", "loadeddata", "canplay", "canplaythrough"].forEach(
            (eventName) => {
              heroVideo.addEventListener(eventName, playMutedNow);
            }
          );

          heroVideo.addEventListener("pause", () => {
            if (document.hidden) return;
            if (soundUnlocked) {
              heroVideo.muted = false;
              heroVideo.play().catch(() => {});
            } else {
              playMutedNow();
            }
          });

          document.addEventListener("visibilitychange", () => {
            if (document.hidden) return;
            if (soundUnlocked) {
              heroVideo.muted = false;
              heroVideo.play().catch(() => {});
            } else {
              playMutedNow();
            }
          });

          window.addEventListener("pageshow", () => {
            if (soundUnlocked) {
              heroVideo.muted = false;
              heroVideo.play().catch(() => {});
            } else {
              playMutedNow();
            }
          });
        };

        const initLazyVideos = () => {
          const videos = document.querySelectorAll("video.lazy-video");
          if (!videos.length) return;

          const loadAndPlay = (video) => {
            const dataSrc = video.getAttribute("data-src");
            if (dataSrc && !video.getAttribute("src")) {
              video.setAttribute("src", dataSrc);
              video.load();
            }
            const playPromise = video.play();
            if (playPromise && typeof playPromise.catch === "function") {
              playPromise.catch(() => {});
            }
          };

          if (!("IntersectionObserver" in window)) {
            videos.forEach((video) => loadAndPlay(video));
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                const video = entry.target;
                if (entry.isIntersecting) {
                  loadAndPlay(video);
                } else {
                  video.pause();
                }
              });
            },
            {
              root: null,
              rootMargin: "80px 0px",
              threshold: 0.25,
            }
          );

          videos.forEach((video) => observer.observe(video));
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", () => {
            initHeroVideo();
            initLazyVideos();
          });
        } else {
          initHeroVideo();
          initLazyVideos();
        }
      })();
    </script>
  </body>
