---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Programa de Neurociencia y Meditación con Jessica Vega Puch. De la ansiedad a la calma."
    />
    <title>De la Ansiedad a la Calma | Jessica Vega Puch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <!-- 1. HERO / VSL PRINCIPAL -->
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="container hero__inner">
          <p class="badge reveal">PROGRAMA DE ANSIEDAD A LA CALMA</p>

          <h1 id="hero-title" class="reveal reveal--delay-1">
            Aprende a vivir una vida sin ansiedad y estar conectada contigo
            mismo y con la realidad.
          </h1>

          <video
            class="reveal reveal--delay-2"
            src="https://res.cloudinary.com/dh3ah77m1/video/upload/v1789530930/Video_Funnel.mp4"
            controls
            playsinline
            preload="metadata"
            style="width: 100%; max-width: 850px; border-radius: 16px; display: block; margin: 0 auto 1.75rem;"
            aria-label="Video principal VSL"
          ></video>

          <a
            class="btn btn--primary btn--wide reveal reveal--delay-3"
            href={checkoutUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Sí, quiero vivir sin ansiedad
          </a>

          <p class="hero__secondary reveal reveal--delay-3">
            ¿Tienes dudas?
            <a
              class="link-whatsapp"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Agenda una llamada de 15 minutos con el equipo
            </a>
          </p>
        </div>
      </section>

      <div class="divider" aria-hidden="true"></div>

      <!-- 2. MENTORA -->
      <section class="section mentora" aria-labelledby="mentora-name">
        <div class="container">
          <div class="mentora__grid">
            <div class="mentora__photo">
              <img
                src="/imagenes/jessica-vega-puch.jpeg"
                alt="Jessica Vega Puch, mentora de neurociencia y meditación"
                width="640"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="mentora__content">
              <p class="mentora__label">Quién te va a formar</p>
              <h2 id="mentora-name" class="mentora__name">Jessica Vega Puch</h2>

              <div class="mentora__credenciales">
                {
                  mentoraMetricas.map((item) => (
                    <div class="mentora__credencial">
                      <div class="mentora__stat">{item.cifra}</div>
                      <p class="mentora__credencial-texto">{item.texto}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. TESTIMONIOS (6 VIDEOS) -->
      <section class="section testimonios" aria-labelledby="testimonios-title">
        <div class="container">
          <h2 id="testimonios-title" class="section__title">
            Historias de transformación y resultados
          </h2>

          <div class="testimonios__grid">
            {
              testimonios.map((item, i) => (
                <div class="testimonio-media">
                  <video
                    controls
                    playsinline
                    preload="metadata"
                    aria-label={`Video testimonio ${i + 1}`}
                  >
                    <source
                      src={
                        item.startAt
                          ? `${item.src}#t=${item.startAt}`
                          : item.src
                      }
                      type="video/mp4"
                    />
                  </video>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 4. ¿PARA QUIÉN ES ESTE CURSO? -->
      <section class="section para-quien" aria-labelledby="para-quien-title">
        <div class="container">
          <h2 id="para-quien-title" class="section__title">
            ¿Para quién es este curso?
          </h2>

          <ul class="para-quien__lista">
            {
              paraQuien.map((item) => (
                <li class="para-quien__item">
                  <span class="para-quien__check" aria-hidden="true">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="none"
                    >
                      <path
                        d="M4.5 10.5l3.5 3.5 7.5-8"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>

          <div class="para-quien__galeria" aria-label="Galería del programa">
            {
              paraQuienGaleria.map((img) => (
                <figure class="para-quien__shot">
                  <img
                    src={img.src}
                    alt={img.alt}
                    width="640"
                    height="480"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 5. ¿QUÉ INCLUYE? -->
      <section class="section incluye" aria-labelledby="incluye-title">
        <div class="container">
          <h2 id="incluye-title" class="section__title">
            Programa: De la Ansiedad a la Calma en 30 días
          </h2>

          <h3 class="incluye__subtitulo">El programa Incluye</h3>
          <ul class="incluye__list">
            {
              pilares.map((item) => (
                <li>
                  <strong>{item.title}</strong>
                  <span>{item.text}</span>
                </li>
              ))
            }
          </ul>

          <details class="incluye__acordeon">
            <summary>¿Quieres ver el programa completo, clase por clase?</summary>
            <ol class="incluye__clases">
              {
                clasesPrograma.map((clase) => (
                  <li>
                    <strong>{clase.title}</strong>
                    <span>{clase.text}</span>
                  </li>
                ))
              }
            </ol>
          </details>
        </div>
      </section>

      <div class="divider" aria-hidden="true"></div>

      <!-- 6. DECISIÓN: urgencia → oferta → CTA -->
      <section
        class="section decision"
        id="reservar"
        aria-labelledby="por-que-ahora-title"
      >
        <div class="container decision__inner">
          <div class="urgencia">
            <h2 id="por-que-ahora-title" class="urgencia__title">Por qué ahora</h2>
            <p>
              Esta es la última cohorte del año. Un programa en comunidad
              funciona mejor cuando todas entran juntas, empiezan el mismo día y
              avanzan al mismo ritmo.
            </p>
            <p class="urgencia__cierre">
              El
              <span class="urgencia__fecha">17 de octubre</span> el acceso se
              cierra para no interrumpir el proceso de la primera parte.
            </p>
            <p>
              Si sabes que este es tu momento, no lo dejes para después. Si no
              entras ahora, tendrás que esperar un año entero con la misma
              ansiedad.
            </p>
          </div>

          <article class="oferta" aria-labelledby="oferta-title">
            <header class="oferta__header">
              <h3 id="oferta-title" class="oferta__titulo">Acceso</h3>
              <p class="oferta__precio">
                <span class="oferta__moneda">S/</span>1220
              </p>
              <p class="oferta__inversion">
                Inversión: S/1220 — Pago único o en 3 cuotas.
              </p>
            </header>

            <ul class="oferta__lista">
              <li class="oferta__item">
                <span class="oferta__check" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="none"
                  >
                    <path
                      d="M4.5 10.5l3.5 3.5 7.5-8"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <p>
                  <strong>Bono especial:</strong> Si te inscribes antes de que
                  cierre el acceso (17 de octubre), te llevas gratis la
                  membresía de una clase por semana (valorizada en S/ 2,100).
                </p>
              </li>
              <li class="oferta__item">
                <span class="oferta__check" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="none"
                  >
                    <path
                      d="M4.5 10.5l3.5 3.5 7.5-8"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <p>
                  <strong>Garantía de Satisfacción:</strong> Si después de las
                  primeras 2 clases sientes que no es para ti, te devolvemos el
                  100% de tu dinero, sin preguntas.
                </p>
              </li>
              <li class="oferta__item">
                <span class="oferta__check" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="none"
                  >
                    <path
                      d="M4.5 10.5l3.5 3.5 7.5-8"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <p>
                  <strong>Última cohorte del año:</strong> El 17 de octubre el
                  acceso se cierra. Si no entras ahora, tendrás que esperar un
                  año entero.
                </p>
              </li>
            </ul>

            <a
              class="btn btn--primary btn--wide oferta__cta"
              href={checkoutUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Reserva tu cupo ahora
            </a>

            <p class="oferta__confianza">
              <span>Pago único o en 3 cuotas</span>
              <span class="oferta__dot" aria-hidden="true">•</span>
              <span>Garantía de satisfacción</span>
            </p>

            <p class="oferta__pie">
              ¿No tienes el monto completo hoy? Puedes dividirlo en 3 cuotas.
            </p>
          </article>

          <p class="decision__secondary">
            ¿Aún tienes dudas?
            <a
              class="link-whatsapp"
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Agenda una llamada de 15 minutos con el equipo
            </a>
          </p>
        </div>
      </section>

      <!-- 7. FAQ -->
      <section class="section faq" aria-labelledby="faq-title">
        <div class="container container--narrow">
          <h2 id="faq-title" class="section__title">Preguntas frecuentes</h2>

          <div class="faq__list">
            {
              faqs.map((item) => (
                <details class="faq__item">
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <!-- BOTÓN FLOTANTE WHATSAPP -->
    <a
      class="whatsapp-float"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escribir por WhatsApp"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M16.04 3C9.4 3 4 8.27 4 14.75c0 2.08.56 4.1 1.63 5.9L4 29l8.56-1.58A12.3 12.3 0 0 0 16.04 26.5C22.68 26.5 28 21.23 28 14.75S22.68 3 16.04 3zm0 21.4c-1.7 0-3.37-.44-4.84-1.28l-.35-.2-5.08.94.96-4.9-.22-.37a9.7 9.7 0 0 1-1.5-5.14c0-5.35 4.5-9.7 10.03-9.7s10.03 4.35 10.03 9.7-4.5 9.7-10.03 9.7zm5.5-7.28c-.3-.15-1.78-.87-2.06-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.45-2.4-1.45-.89-.78-1.49-1.74-1.66-2.04-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.6-.92-2.2-.24-.57-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.48s1.07 2.88 1.22 3.08c.15.2 2.11 3.2 5.12 4.48.72.3 1.28.48 1.72.62.72.23 1.38.2 1.9.12.58-.09 1.78-.72 2.03-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35z"
        ></path>
      </svg>
    </a>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ede6da;
    --cta: #c1563e;
    --text: #222222;
    --text-muted: rgba(34, 34, 34, 0.72);
    --surface: rgba(255, 255, 255, 0.42);
    --border: rgba(34, 34, 34, 0.18);
    --border-strong: rgba(34, 34, 34, 0.28);
    --font-display: "Cormorant Garamond", Georgia, serif;
    --font-body: "Outfit", sans-serif;
    --radius: 4px;
    --shadow-soft: 0 18px 40px rgba(34, 34, 34, 0.08);
    --max: 1100px;
    --narrow: 720px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    margin: 0;
    min-height: 100vh;
    overflow-x: hidden;
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text);
    background:
      radial-gradient(
        ellipse 80% 50% at 50% -10%,
        rgba(193, 86, 62, 0.12),
        transparent 55%
      ),
      linear-gradient(180deg, #f3ede3 0%, var(--bg) 28%, #e8dfd0 100%);
    -webkit-font-smoothing: antialiased;
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
  }

  h1,
  h2,
  h3,
  .section__title,
  .urgencia__title,
  .mentora__name,
  .mentora__stat,
  .incluye__subtitulo,
  .incluye__list strong,
  .incluye__clases strong {
    font-family: var(--font-display);
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(1.7rem, 3.8vw, 2.65rem);
    max-width: min(100%, 900px);
    margin-inline: auto;
    margin-bottom: 1.75rem;
    line-height: 1.2;
  }

  h2 {
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
  }

  h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }

  p,
  li,
  summary,
  .badge,
  .btn,
  .hero__secondary,
  .decision__secondary,
  .link-whatsapp,
  .media__label,
  .mentora__credencial-texto,
  .para-quien__item,
  .incluye__list span,
  .incluye__clases span,
  .oferta__inversion,
  .oferta__item p,
  .urgencia p,
  .faq__item p {
    font-family: var(--font-body);
  }

  p {
    margin: 0 0 1rem;
  }

  .container {
    width: min(100% - 2rem, var(--max));
    margin-inline: auto;
  }

  .container--narrow {
    width: min(100% - 2rem, var(--narrow));
  }

  .section {
    padding: 2.5rem 0;
  }

  .section__title {
