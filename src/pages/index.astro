const optimizeCloudinaryVideo = (
  url: string,
  opts: { width?: number; eco?: boolean; low?: boolean } = {}
) => {
  const { width = 960, eco = false, low = false } = opts;
  const quality = low ? "q_auto:low" : eco ? "q_auto:eco" : "q_auto";
  return url.replace(
    "/video/upload/",
    `/video/upload/w_${width},c_limit,${quality},f_auto/`
  );
};

