            </div>
          ))
        }
      </div>
    </div>

    <main>
      <!-- 1. HERO / VSL PRINCIPAL -->
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="container hero__inner">
          <p class="badge reveal">PROGRAMA DE LA ANSIEDAD A LA CALMA</p>

          <h1 id="hero-title" class="hero__title reveal reveal--delay-1">
            <span class="hero__title-line"
              >Recupera tu capacidad de vivir en el presente sin ansiedad,</span
            >
            <span class="hero__title-line"
              >entrenando tu mente con un método basado en neurociencia.</span
            >
          </h1>

          <div class="hero__video-wrap reveal reveal--delay-2">
            <video
              class="hero__video"
              data-src={heroVideoSrc}
              data-src-mobile={heroVideoSrcMobile}
