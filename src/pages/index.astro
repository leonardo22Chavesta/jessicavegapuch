  "Sufres de ataques de pánico.",
  "No tienes un control total de tus emociones.",
  "Personas que solo buscan aprender Yoga o Meditación.",
];

const paraQuienGaleria = [
  {
    src: "/imagenes/meditacion-grupo.jpeg",
    alt: "Grupo en práctica de meditación",
  },
  {
    src: "/imagenes/jessica-yoga.jpeg",
    alt: "Práctica de yoga y presencia",
  },
  {
    src: "/imagenes/taller-guiado.jpeg",
    alt: "Taller guiado del programa",
  },
  {
    src: "/imagenes/taller-respiracion.jpeg",
    alt: "Ejercicio de respiración y calma",
  },
